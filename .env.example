# CIPS Sentinel server configuration
# Copy to .env.local and fill in. .env.local is git-ignored.

# Local server
PORT=8787
# Bind address. Keep 127.0.0.1 for local only; use 0.0.0.0 behind a firewall/reverse proxy.
HOST=127.0.0.1

# If Node cannot verify the model endpoint TLS chain, point it at the system CA bundle:
# NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem

# Default provider: auto | openai | ollama | mock
LLM_PROVIDER=auto

# ---- OpenAI-compatible (Aliyun MaaS / DeepSeek / bank gateway) ----
LLM_BASE_URL=https://llm-tlndh47wd9ustbss.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=qwen-plus

# ---- Ollama local ----
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b

# ---- Runtime limits ----
MAX_AGENT_STEPS=16
LLM_TIMEOUT_MS=60000
APPROVAL_TIMEOUT_MS=120000
